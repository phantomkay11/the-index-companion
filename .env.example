# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings → API). The publishable key is safe to ship in the app;
# never put the service role key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY

# Push notifications: your EAS project id (npx eas-cli@latest init prints it).
EAS_PROJECT_ID=
# Native maps on Android: a Google Maps SDK for Android key, restricted to this app's package.
GOOGLE_MAPS_ANDROID_API_KEY=
