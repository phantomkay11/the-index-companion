{
  "expo": {
    "name": "The Index",
    "slug": "the-index-companion",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "theindex",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "org.blackfarmersindex.theindex",
      "supportsTablet": true,
      "requireFullScreen": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#007640",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "org.blackfarmersindex.theindex"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#007640",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#007640",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "The Index uses the microphone so you can send voice notes to farms and other members."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "The Index uses your location to show farms near you. It is never shared with other members."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The Index lets farmers add photos of their farm to their listing.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-maps",
        {
          "requestLocationPermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "f4792743-1ac6-404d-8d86-93a6d1cc8726"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/f4792743-1ac6-404d-8d86-93a6d1cc8726"
    }
  }
}
