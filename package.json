{
  "name": "the-index-companion",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/atkinson-hyperlegible": "^0.4.1",
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/young-serif": "^0.4.0",
    "@expo/ui": "~57.0.21",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@supabase/supabase-js": "^2.117.2",
    "expo": "~57.0.26",
    "expo-audio": "~57.0.5",
    "expo-blur": "~57.0.3",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-location": "~57.0.20",
    "expo-maps": "~57.0.3",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-screen-orientation": "~57.0.2",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test:db": "node supabase/tests/policies.test.mjs",
    "import:directory": "node scripts/import-directory.mjs",
    "check:functions": "for f in supabase/functions/*/index.ts; do npx --yes deno@2 check $f || exit 1; done",
    "build:setup-sql": "node scripts/build-setup-sql.mjs",
    "test:functions": "npx --yes deno@2 test supabase/functions",
    "test:lib": "TZ=America/Chicago node --experimental-strip-types --test tests/lib.test.ts && TZ=Pacific/Honolulu node --experimental-strip-types --test tests/lib.test.ts",
    "test:redteam": "node supabase/tests/redteam.test.mjs && node supabase/tests/migration-data.test.mjs",
    "test:web": "npx expo export --platform web && node store/smoke.mjs && node store/interact.mjs",
    "test": "npm run typecheck && npm run lint && npm run test:lib && npm run test:db && npm run test:redteam && npm run check:functions && npm run test:functions",
    "store:capture": "npx expo export --platform web && node store/capture.mjs",
    "store:screenshots": "node store/screenshots.mjs",
    "store:preview": "node store/preview.mjs iphone && python3 store/preview_compose.py iphone && node store/preview.mjs ipad && python3 store/preview_compose.py ipad"
  },
  "private": true
}
